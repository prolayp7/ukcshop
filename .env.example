# Server-side base URL for the UKShop API. Do not expose this as NEXT_PUBLIC_*.
# The API can stay private: browsers only call the storefront, which forwards
# /api/v1/* (src/app/api/v1/[...path]) and /uploads/* (next.config.ts) to it.
UKSHOP_API_URL=http://localhost:3000/api/v1
# Which design this build renders. Must match a slug in src/lib/designs.ts.
THEME=highstreet

# Optional canonical storefront origin (recommended in production).
# SITE_URL=https://your-store.example

# Must match the API PAYMENT_CURRENCY
NEXT_PUBLIC_PAYMENT_CURRENCY=GBP

# Server-only (never NEXT_PUBLIC_). Must match the API REVALIDATION_SECRET; the API sends it to
# POST /api/revalidate after admin changes. Generate with: openssl rand -hex 32
REVALIDATION_SECRET=
