# Server-side base URL for the UKShop API. Do not expose this as NEXT_PUBLIC_*.
UKSHOP_API_URL=http://localhost:3000/api/v1
# Same API, reachable from the browser - used by auth/cart/checkout/account,
# which call the storefront API directly rather than through a Next proxy.
NEXT_PUBLIC_UKSHOP_API_URL=http://localhost:3000/api/v1
# Which design this build renders. Must match a slug in src/lib/designs.ts.
THEME=highstreet

# Optional canonical storefront origin (recommended in production).
# SITE_URL=https://your-store.example
